# Copy to .env for running the app outside docker-compose (e.g. `uvicorn hoa.main:app --reload`).
# In Kubernetes these are injected via the Helm chart's values, not a .env file.

TENANT_ID=11111111-1111-1111-1111-111111111111
DATABASE_URL=postgresql+asyncpg://hoa_app:app_dev_password@localhost:55432/hoa
JWT_SECRET=dev-secret-change-me
LOG_LEVEL=INFO
